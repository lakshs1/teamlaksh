{
  "name": "hackathon-backend",
  "version": "1.0.0",
  "description": "Reusable hackathon backend template — Express + TS + Drizzle + Zod + Swagger",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "start": "npx tsx src/index.ts",
    "build": "npx tsc",
    "test": "npx tsx --test src/**/*.test.ts",
    "db:generate": "npm --prefix ../db run db:generate",
    "db:migrate": "npm --prefix ../db run db:migrate",
    "db:push": "npm --prefix ../db run db:push",
    "db:studio": "npm --prefix ../db run db:studio"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "bcryptjs": "^3.0.2",
    "bun": "^1.4.2",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.7.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.9",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.3"
  }
}
