# ═══════════════════════════════════════════════════════════
# HACKATHON BACKEND — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackathon_db

# ── JWT Secrets ───────────────────────────────────────────
# Generate secrets: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-access-secret-here
JWT_REFRESH_SECRET=change-me-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
