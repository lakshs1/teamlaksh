# DealFlow360 Frontend Environment Variables
# Set to 'true' to use instant rich mock data for UI design & offline iteration.
# Set to 'false' when switching back to live backend & PostgreSQL database.
VITE_USE_MOCK_DATA=false

# For local development (both FE & BE running locally):
VITE_API_URL=http://localhost:5000/api/v1
# For remote / ngrok tunnel testing:
# VITE_API_URL=https://nonmanually-polyarticular-chantell.ngrok-free.dev/api/v1
VITE_APP_NAME=DealFlow360
